{
  "name": "dr-ali-ahmed-homepage",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "playwright test",
    "visual:diff": "node scripts/visual-diff.mjs",

    "prepare": "husky install",
    "security:gitleaks": "gitleaks detect --source . --no-banner",
    "security:semgrep": "semgrep --config p/default .",
    "security:npm": "npm audit --audit-level=high || echo \"npm audit skipped\"",
    "security:trivy": "trivy fs --timeout 10m --severity HIGH,CRITICAL .",
    "security:all": "npm run security:gitleaks && npm run security:semgrep && npm run security:npm && npm run security:trivy"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^1.27.0",
    "next": "^15.5.22",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.10.5",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^16.2.12",
    "husky": "^9.1.7",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.18",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}